{
  "name": "c2hell-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend opcional de C2 HELL en Cloudflare Workers + D1 (SQLite). Sin dependencias de ejecución.",
  "scripts": {
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute c2hell --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute c2hell --local --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
